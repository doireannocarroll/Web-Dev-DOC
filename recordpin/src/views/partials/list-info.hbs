<table class="table is-fullwidth">
    <thead>
        <tr>
            <th>Address</th>
            <th>County</th>
            <th>Vinyl Rarity</th>
        </tr>
    </thead>
    <tbody>
        {{#each shop.infos}}
        <tr>
            <td>
                {{address}}
            </td>
            <td>
                {{county}}
            </td>
            <td>
                {{vinylRarity}}
            </td>
            <td>
                <a href="/shop/{{../shop._id}}/deleteinfo/{{_id}}" class="ui icon button">
                    <i class="trash icon"></i>
                </a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>