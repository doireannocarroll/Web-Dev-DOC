<table class="table is-fullwidth">
  <thead>
    <tr>
      <th>Address</th>
      <th>County</th>
      <th>Vinyl Rarity</th>
    </tr>
  </thead>
  <tbody>
    {{#each shopInfo.info}}
      <tr>
        <td>
          {{address}}
        </td>
        <td>
          {{county}}
        </td>
        <td>
          {{vinylRarity}}
        </td>
      <td>
          <a href="/shopName/{{../shopName._id}}/deleteinfo/{{_id}}" class="ui icon button">
            <i class="fas fa-trash"></i>
          </a>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

