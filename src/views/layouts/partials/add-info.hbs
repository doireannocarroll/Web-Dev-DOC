<form class="box" action="/playlist/{{playlist._id}}/addtrack" method="POST">
  <label>Enter Shop Information:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <input class="input" type="text" placeholder="Enter Address" name="address">
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Enter County" name="county">
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Enter Vinyl Rarity" name="vinylRarity">
      </div>
    </div>
  </div>
  <button class="button is-primary">Add Info</button>
</form>
